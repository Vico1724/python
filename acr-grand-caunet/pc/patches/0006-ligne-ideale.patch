diff --git a/tools/acr-ref/Officials.cs b/tools/acr-ref/Officials.cs
new file mode 100644
index 0000000..2b953f4
--- /dev/null
+++ b/tools/acr-ref/Officials.cs
@@ -0,0 +1,229 @@
+using System.Buffers.Binary;
+using System.Globalization;
+using System.Numerics;
+using System.Text.Json.Nodes;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Assets.Objects;
+using CUE4Parse.UE4.Assets.Objects.Properties;
+using CUE4Parse.UE4.Objects.Core.Math;
+using CUE4Parse.UE4.Objects.UObject;
+using static AcrRef.Splines;
+
+namespace AcrRef;
+
+/// [Grand Caunet] `stage-build --officials <cell,cell>`: the start and finish officials of Hafren South (docs/15, method B).
+///
+/// Hafren South keeps its start officials in cell A0I1 (the seated official at the car's start point, the marshal with the
+/// stick at the start line, marshals, two gantries, the "Start" / "ComeCloser" spline triggers as child actors of the stick
+/// marshal) and its finish officials in cell 0QY7 (official with a laptop, stop marshal, marshals, six crowd groups and their
+/// sounds, a gantry). Both are spatially loaded at the Welsh start and finish, 2.4 km away from ours, so they never load.
+///
+/// Each actor root of these cells is moved like the start, sector and stop actors of the gameplay cell (BuildCell): its
+/// distance along the host centreline is taken relative to the nearest anchor (car start point, start trigger, stop
+/// trigger), carried to the same anchor on our line, with the same lateral offset; its yaw turns with the road. Its height is
+/// put back on our ground (stage collision.glb) at the same height above the host ground (host BakedData) as in Wales. The
+/// classes listed in --officials-sink (default: the Welsh gantries) are sunk 1 000 m instead. Exports keep their sizes;
+/// attached components and child actors follow their parent. In the persistent level the cells are made always loaded
+/// (Scenery.WithAlwaysLoaded); they must also be kept in the forward layers (scenery.toml keep).
+internal static partial class StageBuild
+{
+    internal const string OfficialsSinkDefault = "BC_GantryWales_C";
+    const double HostHalfWidthM = 1.9;      // Hafren South: median half-width between its border splines (1.88 m left, 1.90 m right)
+    const double MaxAboveGroundCm = 25;
+
+    /// Half-width (cm) of our road at distance s (cm) along the new centreline: the gate there (newLine points = gates).
+    static double OurHalfWidthCm(Ir ir, Polyline line, double s)
+    {
+        int i = Array.BinarySearch(line.S, s);
+        if (i < 0) i = ~i - 1;
+        i = Math.Clamp(i, 0, ir.Gates.Count - 1);
+        var (_, _, l, r) = ir.Gates[i];
+        return Math.Sqrt((l[0] - r[0]) * (l[0] - r[0]) + (l[2] - r[2]) * (l[2] - r[2])) / 2 * 100;
+    }
+
+    static string CellRel(string id) => $@"acr\Content\Levels\WalesS4HafrenSouth\_Generated_\{id}";
+
+    static JsonObject RelocateOfficials(Options o, string legacy, string outRoot, Ir ir, Placement pl, string[] cells,
+                                        Polyline hostLine, Polyline newLine, List<(string role, double hostS, double newS)> anchors,
+                                        double minS, double maxS)
+    {
+        var sink = (o.Named.GetValueOrDefault("officials-sink") ?? OfficialsSinkDefault)
+            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();
+        var ours = new SurfaceGrid(Path.Combine(ir.Dir, "collision.glb"), pl);
+        var hostCols = BakedEdit.ParseColliders(File.ReadAllBytes(Path.ChangeExtension(HostPaths.Resolve(legacy, HostPaths.Baked), ".uexp"))).Item1;
+        using var provider = Program.Open(o);
+        var res = new JsonObject();
+        foreach (var id in cells)
+        {
+            var path = HostPaths.Resolve(legacy, CellRel(id));
+            var pkg = new LegacyPackage(path);
+            var objs = provider.LoadPackage($"acr/Content/Levels/WalesS4HafrenSouth/_Generated_/{id}.umap").GetExports().ToList();
+            if (objs.Count != pkg.ExportCount || Enumerable.Range(0, objs.Count).Any(i => objs[i].Name != pkg.ExportName(i)))
+                throw new InvalidDataException($"officials: CUE4Parse export order differs from the legacy package of cell {id}");
+            var moved = new JsonArray();
+            foreach (var act in objs)
+            {
+                if (act.Outer?.Name.ToString() != "PersistentLevel") continue;
+                if (!act.TryGetValue(out FPackageIndex rootRef, "RootComponent") || !rootRef.IsExport) continue;
+                int rc = rootRef.Index - 1;
+                var root = objs[rc];
+                string cls = act.ExportType;
+                if (root.TryGetValue(out FPackageIndex parent, "AttachParent") && !parent.IsNull) { moved.Add($"{act.Name}: attached, follows its parent"); continue; }
+                if (!root.TryGetValue(out FVector hl, "RelativeLocation")) { moved.Add($"{act.Name}: no stored location, left in place"); continue; }
+                var data = (byte[])pkg.GetExportData(rc).Clone();
+                int locAt = FindDoubles(data, [hl.X, hl.Y, hl.Z]);
+                if (sink.Contains(cls))
+                {
+                    WriteDoubles(data, locAt + 16, hl.Z - 100000);
+                    pkg.SetExportData(rc, data);
+                    moved.Add($"{cls} {act.Name}: sunk 1000 m");
+                    continue;
+                }
+                var (sh, lat, up, hHead) = hostLine.Project(new V3(hl.X, hl.Y, hl.Z));
+                var anc = anchors.MinBy(x => Math.Abs(x.hostS - sh));
+                double s0 = anc.newS + (sh - anc.hostS), s = Math.Clamp(s0, minS, maxS);
+                // lateral: same distance to the road edge as in Wales (our road is wider than Hafren's); on the host road, scaled
+                double half = OurHalfWidthCm(ir, newLine, s), hostHalf = HostHalfWidthM * 100;
+                double nlat = Math.Abs(lat) > hostHalf ? Math.Sign(lat) * (Math.Abs(lat) - hostHalf + half) : lat * half / hostHalf;
+                var nl = newLine.At(s, nlat, up, out double nHead);
+                // height: same height above the ground as in Wales (host BakedData -> our collision.glb), never below our
+                // ground and at most MaxAboveGroundCm above it (a ditch or a bank under the host actor would make it float)
+                double z = nl.Z;
+                var g0 = BakedEdit.GroundHeight(hostCols, new Vector2((float)(hl.X / 100), (float)(hl.Y / 100)));
+                var g1 = ours.HeightAt(nl.X / 100, nl.Y / 100);
+                string h = "line";
+                if (g0 is { } a0 && g1 is { } a1)
+                {
+                    double above = Math.Clamp(hl.Z - a0 * 100, 0, MaxAboveGroundCm);
+                    z = a1 * 100 + above;
+                    h = $"ground {F(a1, "0.##")} m + {F(above / 100, "0.##")} m";
+                }
+                WriteDoubles(data, locAt, nl.X, nl.Y, z);
+                string rot = "yaw not stored, kept";
+                if (root.TryGetValue(out FRotator hr, "RelativeRotation"))
+                {
+                    double yaw = NormDeg(hr.Yaw + (nHead - hHead) * 180 / Math.PI);
+                    WriteDoubles(data, FindDoubles(data, [hr.Pitch, hr.Yaw, hr.Roll]) + 8, yaw);
+                    rot = $"yaw {F(hr.Yaw, "0.#")} -> {F(yaw, "0.#")}";
+                }
+                pkg.SetExportData(rc, data);
+                moved.Add($"{cls} {act.Name}: {anc.role} {F((sh - anc.hostS) / 100, "+0.#;-0.#")} m along, lateral {F(lat / 100, "0.##")} -> {F(nlat / 100, "0.##")} m" +
+                          $"{(Math.Abs(s - s0) > 1 ? " (clamped)" : "")} -> UE ({F(nl.X, "0")}, {F(nl.Y, "0")}, {F(z, "0")}), {h}, {rot}");
+            }
+            var dest = Path.Combine(outRoot, CellRel(id) + Path.GetExtension(path));
+            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+            foreach (var ext in new[] { ".ubulk", ".uptnl" })
+                if (File.Exists(Path.ChangeExtension(path, ext))) File.Copy(Path.ChangeExtension(path, ext), Path.ChangeExtension(dest, ext), true);
+            pkg.SaveTo(dest);
+            foreach (var m in moved) Console.WriteLine($"  officials {id[..4]}: {m}");
+            res[id] = moved;
+        }
+        return res;
+    }
+
+    /// The officials' cells loaded wherever the car is (they must already be in the forward layers: scenery keep).
+    /// bIsAlwaysLoaded alone is not enough: a cooked World Partition loads the cells of the grid squares around the
+    /// streaming source (MainGrid: 350 m squares, 640 m loading range), and these cells sit in the level-0 squares of the
+    /// Welsh start and finish, 2 km from ours (our finish is even outside the Welsh grid). Each officials' cell therefore
+    /// swaps its reference in the runtime spatial hash (one int32, same size) with a cell of the top grid level (one
+    /// square over the whole world, always in range) that never streams in the forward variant (reverse layers only):
+    /// the officials' cell is then queried everywhere, the donor goes to the Welsh square, where its inactive layer keeps
+    /// it unloaded.
+    static JsonObject AlwaysLoadCells(Options o, string legacy, string outRoot, string[] cells)
+    {
+        var dest = Path.Combine(outRoot, Scenery.Persistent + ".umap");
+        var src = File.Exists(dest) ? dest : HostPaths.Resolve(legacy, Scenery.Persistent);
+        var pkg = new LegacyPackage(src);
+        int hash = Enumerable.Range(0, pkg.ExportCount).Single(i => pkg.ExportClass(i) == "WorldPartitionRuntimeSpatialHash");
+        var top = TopGridCells(o);
+        int CellExport(string id) => Enumerable.Range(0, pkg.ExportCount).SingleOrDefault(i => pkg.ExportClass(i) == Scenery.CellExportClass && pkg.ExportName(i) == id, -1);
+        var donors = new Queue<string>(top.Where(id =>
+        {
+            int e = CellExport(id);
+            if (e < 0) return false;
+            var desc = Scenery.CellState(pkg, pkg.GetExportData(e)).describe;
+            return !desc.Contains("BE01") && !desc.Contains("E8A3") && !desc.Contains("layers none");   // never streams forward
+        }).OrderBy(x => x));
+        var r = new JsonObject();
+        foreach (var id in cells)
+        {
+            int e = CellExport(id);
+            if (e < 0) throw new InvalidDataException($"officials: streaming cell {id} not in the persistent level");
+            var d = pkg.GetExportData(e);
+            var (always, desc) = Scenery.CellState(pkg, d);
+            if (!desc.Contains("BE01")) throw new InvalidDataException($"officials: cell {id} is not in the forward gameplay layer ({desc}): add it to scenery.toml keep");
+            if (!always) pkg.SetExportData(e, Scenery.WithAlwaysLoaded(d));
+            var cell = new JsonObject { ["state"] = $"{desc}; always loaded {(always ? "already" : "set")}" };
+            if (top.Contains(id)) cell["grid"] = "already in the top grid level";
+            else
+            {
+                if (donors.Count == 0) throw new InvalidDataException("officials: no top-level grid cell left that never streams forward");
+                string donor = donors.Dequeue();
+                int de = CellExport(donor);
+                var h = (byte[])pkg.GetExportData(hash).Clone();
+                int at = UniqueInt32(h, e + 1, id), dat = UniqueInt32(h, de + 1, donor);
+                BinaryPrimitives.WriteInt32LittleEndian(h.AsSpan(at), de + 1);
+                BinaryPrimitives.WriteInt32LittleEndian(h.AsSpan(dat), e + 1);
+                pkg.SetExportData(hash, h);
+                cell["grid"] = $"swapped with top-level cell {donor} (spatial hash bytes {at} and {dat})";
+                cell["hash_offset"] = dat;
+            }
+            r[id] = cell;
+            Console.WriteLine($"officials: cell {id} {cell["state"]}; {cell["grid"]}");
+        }
+        if (src != dest)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+            foreach (var ext in new[] { ".ubulk", ".uptnl" })
+                if (File.Exists(Path.ChangeExtension(src, ext))) File.Copy(Path.ChangeExtension(src, ext), Path.ChangeExtension(dest, ext), true);
+        }
+        pkg.SaveTo(dest);
+        return r;
+    }
+
+    static int UniqueInt32(byte[] d, int value, string what)
+    {
+        var hits = new List<int>();
+        for (int i = 0; i + 4 <= d.Length; i++)
+            if (BinaryPrimitives.ReadInt32LittleEndian(d.AsSpan(i)) == value) hits.Add(i);
+        if (hits.Count != 1) throw new InvalidDataException($"officials: reference to cell {what} (index {value}) found {hits.Count} times in the spatial hash, expected once");
+        return hits[0];
+    }
+
+    /// The cells of the top level of MainGrid (one square over the whole world), read from the vanilla persistent level.
+    static HashSet<string> TopGridCells(Options o)
+    {
+        using var provider = Program.Open(o);
+        var hash = provider.LoadPackage(Scenery.PersistentLevel).GetExports().Single(x => x.ExportType == "WorldPartitionRuntimeSpatialHash");
+        static IEnumerable<FStructFallback> Structs(UScriptArray? a) =>
+            a?.Properties.Select(p => (FStructFallback)((StructProperty)p).Value!.StructType) ?? [];
+        var grid = Structs(hash.GetOrDefault<UScriptArray>("StreamingGrids")).Single(g => g.GetOrDefault<FName>("GridName").Text == "MainGrid");
+        var levels = Structs(grid.GetOrDefault<UScriptArray>("GridLevels")).ToList();
+        var topLevel = levels.Last(l => Structs(l.GetOrDefault<UScriptArray>("LayerCells")).Any());
+        return Structs(topLevel.GetOrDefault<UScriptArray>("LayerCells"))
+            .SelectMany(lc => lc.GetOrDefault<UScriptArray>("GridCells")?.Properties ?? [])
+            .Select(p => ((FPackageIndex)p.GenericValue!).Name).ToHashSet();
+    }
+
+    static int CheckOfficials(string root, JsonNode report, TextWriter w)
+    {
+        int fail = 0;
+        var pkg = new LegacyPackage(HostPaths.Resolve(root, Scenery.Persistent));
+        foreach (var (id, _) in report.AsObject())
+        {
+            int e = Enumerable.Range(0, pkg.ExportCount).SingleOrDefault(i => pkg.ExportClass(i) == Scenery.CellExportClass && pkg.ExportName(i) == id, -1);
+            bool ok = e >= 0 && Scenery.CellState(pkg, pkg.GetExportData(e)).alwaysLoaded && File.Exists(HostPaths.Resolve(root, CellRel(id)));
+            string grid = "already in the top grid level";
+            if (report[id]?["hash_offset"] is { } off)
+            {
+                int h = Enumerable.Range(0, pkg.ExportCount).Single(i => pkg.ExportClass(i) == "WorldPartitionRuntimeSpatialHash");
+                bool inTop = e >= 0 && BinaryPrimitives.ReadInt32LittleEndian(pkg.GetExportData(h).AsSpan((int)off)) == e + 1;
+                ok &= inTop;
+                grid = inTop ? "referenced in the top grid level" : "NOT in the top grid level";
+            }
+            w.WriteLine($"{(ok ? "PASS" : "FAIL")} officials: cell {id} shipped, always loaded, {grid}");
+            if (!ok) fail++;
+        }
+        return fail;
+    }
+}
diff --git a/tools/acr-ref/ServicePark.cs b/tools/acr-ref/ServicePark.cs
new file mode 100644
index 0000000..8c56271
--- /dev/null
+++ b/tools/acr-ref/ServicePark.cs
@@ -0,0 +1,124 @@
+using System.Text.Json.Nodes;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Objects.Core.Math;
+using CUE4Parse.UE4.Objects.UObject;
+
+namespace AcrRef;
+
+/// [Grand Caunet] `stage-build --service-park 1`: a very small service park at stage.json `service_park` (docs/16).
+///
+/// The service park of Hafren South lives in the persistent level (479 actors tagged ServicePark) at its Welsh place,
+/// outside our scenery. The game shows those actors only on the "Service park" screen and hides them during the stage.
+/// The actors whose root lies within `radius_m` of the ServiceParkTargetPoint (where the car is shown) are moved as one
+/// block: rotated about the vertical so that the car faces stage.json `forward`, put at `target`, each root set on our
+/// ground (stage collision.glb) at its Welsh height above the park floor. The other tagged actors (rest of the park, its
+/// 3 x 3 km ground SM_WalesServiceParkTerrain) are sunk 1 000 m, except the classes whose effect is not hidden with the
+/// actor (ambient sound, rain occlusion volume, PCG exclusion) and the turbines, left in place. Actors already moved by
+/// --characters keep their place. In-place rewrites only (3 location doubles, 1 yaw double): header and size unchanged.
+internal static partial class StageBuild
+{
+    static readonly HashSet<string> ServiceParkKeepClasses = ["BC_MyhTurbineA_C", "BC_PCG_Exclusion_C", "ManagedAmbientSound", "WeatherOcclusionVolume"];
+    // Sunk even near the car: the tyre rack spawns its tyres as actors of their own, which the game does not hide with the
+    // park during the stage (test of the 19th version, 17/11/2026: two tyres floating by the road at the start).
+    static readonly HashSet<string> ServiceParkSinkClasses = ["BC_TiresRack_C"];
+
+    static JsonObject RelocateServicePark(Options o, string legacy, string outRoot, Ir ir, Placement pl)
+    {
+        var stage = JsonNode.Parse(File.ReadAllText(Path.Combine(ir.Dir, "stage.json")))!;
+        var sp = stage["service_park"] as JsonObject ?? throw new InvalidDataException("--service-park 1: stage.json has no service_park");
+        double[] V(string k) => sp[k]!.AsArray().Select(x => x!.GetValue<double>()).ToArray();
+        var target = pl.ToUe(V("target"));
+        var fwd = V("forward");
+        var q0 = pl.ToPhysics(0, 0, 0); var q1 = pl.ToPhysics(fwd[0], 0, fwd[2]);
+        double heading = Math.Atan2(q1.Z - q0.Z, q1.X - q0.X) * 180 / Math.PI;
+        double radius = sp["radius_m"]!.GetValue<double>() * 100;
+
+        var dest = Path.Combine(outRoot, Scenery.Persistent + ".umap");
+        var src = File.Exists(dest) ? dest : HostPaths.Resolve(legacy, Scenery.Persistent);
+        var pkg = new LegacyPackage(src);
+        var (h0, u0) = pkg.Save();
+        using var provider = Program.Open(o);
+        var objs = provider.LoadPackage(Scenery.PersistentLevel).GetExports().ToList();
+        if (objs.Count != pkg.ExportCount || Enumerable.Range(0, objs.Count).Any(i => objs[i].Name != pkg.ExportName(i)))
+            throw new InvalidDataException("service park: CUE4Parse export order differs from the legacy persistent level");
+
+        bool Tagged(UObject a) => a.GetOrDefault<FName[]>("Tags")?.Any(n => n.Text == "ServicePark") == true;
+        var actors = objs.Where(a => a.Outer?.Name.ToString() == "PersistentLevel" && Tagged(a)).ToList();
+        (UObject root, int rc)? Root(UObject a) =>
+            a.TryGetValue(out FPackageIndex r, "RootComponent") && r.IsExport ? (objs[r.Index - 1], r.Index - 1) : null;
+        var tp = actors.Single(a => a.ExportType == "ServiceParkTargetPoint");
+        var (troot, _) = Root(tp) ?? throw new InvalidDataException("service park: target point without root");
+        var hT = troot.GetOrDefault<FVector>("RelativeLocation");
+        double tYaw = troot.TryGetValue(out FRotator tr, "RelativeRotation") ? tr.Yaw : 0;
+        double psi = NormDeg(heading - tYaw), c = Math.Cos(psi * Math.PI / 180), s = Math.Sin(psi * Math.PI / 180);
+        var ours = new SurfaceGrid(Path.Combine(ir.Dir, "collision.glb"), pl);
+
+        var near = new List<(UObject a, UObject root, int rc, FVector l)>();
+        var far = new List<(UObject a, UObject root, int rc, FVector l)>();
+        int kept = 0;
+        foreach (var a in actors)
+        {
+            if (ServiceParkKeepClasses.Contains(a.ExportType)) { kept++; continue; }
+            if (Root(a) is not { } r || !r.root.TryGetValue(out FVector l, "RelativeLocation")) continue;
+            if (r.root.TryGetValue(out FPackageIndex par, "AttachParent") && !par.IsNull) continue;
+            double d = Math.Sqrt((l.X - hT.X) * (l.X - hT.X) + (l.Y - hT.Y) * (l.Y - hT.Y));
+            (d <= radius ? near : far).Add((a, r.root, r.rc, l));
+        }
+        var zs = near.Select(n => (double)n.l.Z).OrderBy(z => z).ToList();
+        double floor = zs[zs.Count / 2];
+        int moved = 0, sunk = 0, skipped = 0;
+        double tz = 0;
+        foreach (var (a, root, rc, l) in near.Concat(far))
+        {
+            var data = (byte[])pkg.GetExportData(rc).Clone();
+            int at;
+            try { at = FindDoubles(data, [l.X, l.Y, l.Z]); }
+            catch (InvalidDataException) { skipped++; continue; }   // already moved (--characters)
+            bool isNear = near.Any(n => n.rc == rc) && !ServiceParkSinkClasses.Contains(a.ExportType);
+            if (!isNear) { WriteDoubles(data, at + 16, l.Z - 100000); pkg.SetExportData(rc, data); sunk++; continue; }
+            double dx = l.X - hT.X, dy = l.Y - hT.Y;
+            double nx = target.X + c * dx - s * dy, ny = target.Y + s * dx + c * dy;
+            double g = (ours.HeightAt(nx / 100, ny / 100) ?? target.Z / 100) * 100;
+            double nz = g + (l.Z - floor);
+            WriteDoubles(data, at, nx, ny, nz);
+            if (root.TryGetValue(out FRotator hr, "RelativeRotation"))
+                WriteDoubles(data, FindDoubles(data, [hr.Pitch, hr.Yaw, hr.Roll]) + 8, NormDeg(hr.Yaw + psi));
+            pkg.SetExportData(rc, data);
+            if (a == tp) tz = nz;
+            moved++;
+        }
+        var (h1, u1) = pkg.Save();
+        if (!h0.AsSpan().SequenceEqual(h1) || u0.Length != u1.Length) throw new InvalidDataException("service park: header or package size changed");
+        if (src != dest)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+            foreach (var ext in new[] { ".ubulk", ".uptnl" })
+                if (File.Exists(Path.ChangeExtension(src, ext))) File.Copy(Path.ChangeExtension(src, ext), Path.ChangeExtension(dest, ext), true);
+        }
+        pkg.SaveTo(dest);
+        Console.WriteLine($"service park: {moved} actors within {F(radius / 100, "0.#")} m of the car moved to UE ({F(target.X, "0")}, {F(target.Y, "0")}, {F(tz, "0")}), " +
+                          $"turned {F(psi, "0.#")} deg (car heading {F(heading, "0.#")}); {sunk} sunk 1000 m, {kept} left in place, {skipped} already moved");
+        return new JsonObject
+        {
+            ["moved"] = moved, ["sunk"] = sunk, ["kept_in_place"] = kept, ["already_moved"] = skipped, ["turn_deg"] = psi,
+            ["target_actor"] = tp.Name, ["target_root"] = troot.Name, ["target_ue"] = new JsonArray(target.X, target.Y, tz),
+        };
+    }
+
+    static int CheckServicePark(string root, JsonNode report, TextWriter w)
+    {
+        var pkg = new LegacyPackage(HostPaths.Resolve(root, Scenery.Persistent));
+        bool ok;
+        try
+        {
+            int a = pkg.FindExport(report["target_actor"]!.GetValue<string>());
+            int r = pkg.FindExport(report["target_root"]!.GetValue<string>(), null, e => pkg.ExportOuter(e) == a + 1);
+            var t = report["target_ue"]!.AsArray().Select(x => x!.GetValue<double>()).ToArray();
+            FindDoubles(pkg.GetExportData(r), t);
+            ok = report["moved"]!.GetValue<int>() > 50;
+        }
+        catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException) { ok = false; }
+        w.WriteLine($"{(ok ? "PASS" : "FAIL")} service park: {report["moved"]} actors moved, car point at its new place, {report["sunk"]} sunk");
+        return ok ? 0 : 1;
+    }
+}
diff --git a/tools/acr-ref/Splines.cs b/tools/acr-ref/Splines.cs
index fbe0305..bd25bd5 100644
--- a/tools/acr-ref/Splines.cs
+++ b/tools/acr-ref/Splines.cs
@@ -318,6 +318,16 @@ internal static class Splines
         return r;
     }
 
+    /// [Grand Caunet] one key per spline point (InVal = point index), value per point, interp mode from the template.
+    public static Curve ValuesFloatCurve(IReadOnlyList<double> values, Curve template)
+    {
+        var first = template.Points.Count > 0 ? template.Points[0] : new Point { Out = [0], Arrive = [0], Leave = [0], Mode = CIM_Linear };
+        var c = new Curve { Kind = 'f', Looped = template.Looped, LoopKeyOffset = template.LoopKeyOffset };
+        for (int i = 0; i < values.Count; i++)
+            c.Points.Add(new Point { InVal = i, Out = [values[i]], Arrive = [0], Leave = [0], Mode = first.Mode });
+        return c;
+    }
