diff --git a/tools/acr-ref/Weather.cs b/tools/acr-ref/Weather.cs
new file mode 100644
index 0000000..d8a8ae8
--- /dev/null
+++ b/tools/acr-ref/Weather.cs
@@ -0,0 +1,81 @@
+using System.Globalization;
+using System.Text.Json.Nodes;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Assets.Objects;
+
+namespace AcrRef;
+
+/// [Grand Caunet] `stage-build --level-wetness <0..1>`: the base wetness of the host level's weather actor.
+///
+/// Hafren South's BC_WeatherActor_C stores weather_data { global_day_time 1559.361, global_wetness 0.1, global_gloominess
+/// 0.45, global_fogginess 0.2, global_gust 0.2 } (floats, in that order, in the actor's export); Munster's weather actor
+/// stores no wetness at all. On a gravel host a damp start is harmless; on a tarmac stage it lowers the friction
+/// (PM_SurfaceTarmacSmooth FrictionReductionConstantWet) and dries slowly at 4 deg C. Same technique as Characters.cs: the
+/// one float is rewritten in place, export sizes, header, names and imports unchanged, the host value read with CUE4Parse.
+internal static class Weather
+{
+    const string ActorClass = "BC_WeatherActor_C";
+
+    static string F(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
+
+    /// Offset in the actor's export of the float run (day time, wetness), or throws if absent or not unique.
+    static int WetnessAt(byte[] d, float dayTime, float wetness)
+    {
+        var pat = new byte[8];
+        BitConverter.GetBytes(dayTime).CopyTo(pat, 0); BitConverter.GetBytes(wetness).CopyTo(pat, 4);
+        int first = d.AsSpan().IndexOf(pat);
+        if (first < 0) throw new InvalidDataException($"weather: global_day_time {F(dayTime)} followed by global_wetness {F(wetness)} not found");
+        if (d.AsSpan(first + 1).IndexOf(pat) >= 0) throw new InvalidDataException("weather: global_day_time / global_wetness found more than once");
+        return first + 4;
+    }
+
+    public static JsonObject Build(string legacy, string outRoot, double wetness, Options o)
+    {
+        if (wetness is < 0 or > 1) throw new ArgumentException("--level-wetness must be between 0 and 1");
+        var dest = Path.Combine(outRoot, Scenery.Persistent + ".umap");
+        var src = File.Exists(dest) ? dest : HostPaths.Resolve(legacy, Scenery.Persistent);
+        var pkg = new LegacyPackage(src);
+        var (h0, u0) = pkg.Save();
+
+        using var provider = Program.Open(o);
+        var host = provider.LoadPackage(Scenery.PersistentLevel).GetExports().Single(x => x.Class?.Name.ToString() == ActorClass);
+        if (!host.TryGetValue(out FStructFallback wd, "weather_data")
+            || !wd.TryGetValue(out float dayTime, "global_day_time") || !wd.TryGetValue(out float wet0, "global_wetness"))
+            throw new InvalidDataException("weather: the host weather actor has no weather_data.global_day_time / global_wetness (game update?)");
+
+        int actor = pkg.FindExport(host.Name, ActorClass);
+        var data = (byte[])pkg.GetExportData(actor).Clone();
+        int at = WetnessAt(data, dayTime, wet0);
+        BitConverter.GetBytes((float)wetness).CopyTo(data, at);
+        pkg.SetExportData(actor, data);
+        var (h1, u1) = pkg.Save();
+        if (!h0.AsSpan().SequenceEqual(h1) || u0.Length != u1.Length)
+            throw new InvalidDataException("weather: header or package size changed");
+        if (src != dest)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+            foreach (var ext in new[] { ".ubulk", ".uptnl" })
+                if (File.Exists(Path.ChangeExtension(src, ext))) File.Copy(Path.ChangeExtension(src, ext), Path.ChangeExtension(dest, ext), true);
+        }
+        pkg.SaveTo(dest);
+        Console.WriteLine($"weather: {host.Name} global_wetness {F(wet0)} -> {F(wetness)} (byte {at} of its export); header and size unchanged");
+        return new JsonObject { ["actor"] = host.Name, ["day_time"] = dayTime, ["from"] = wet0, ["to"] = wetness, ["offset"] = at };
+    }
+
+    /// stage-check: the weather actor holds the requested wetness after the day time.
+    public static int Check(string root, JsonNode report, TextWriter w)
+    {
+        var pkg = new LegacyPackage(HostPaths.Resolve(root, Scenery.Persistent));
+        bool ok;
+        string why = "";
+        try
+        {
+            var d = pkg.GetExportData(pkg.FindExport(report["actor"]!.GetValue<string>()));
+            WetnessAt(d, report["day_time"]!.GetValue<float>(), (float)report["to"]!.GetValue<double>());
+            ok = true;
+        }
+        catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException) { ok = false; why = $" ({ex.Message})"; }
+        w.WriteLine($"{(ok ? "PASS" : "FAIL")} weather: level weather actor global_wetness {report["from"]} -> {report["to"]}{why}");
+        return ok ? 0 : 1;
+    }
+}
