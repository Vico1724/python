+using System.Globalization;
+using System.Text.Json.Nodes;
+using CUE4Parse.UE4.Assets.Exports;
+using CUE4Parse.UE4.Objects.Core.Math;
+
+namespace AcrRef;
+
+/// [Grand Caunet] `stage-build --characters 1`: the marshals and spectators that Hafren South keeps always loaded in its
+/// persistent level (service park, X ~3.25 km, Y ~1.16 km, far outside the stage) are moved onto the stage, at the places
+/// listed in stage.json `characters.items` (actor label, position = feet, forward = gaze, IR frame like the triggers).
+///
+/// Same technique as the start, sectors and stop zone of the gameplay cell (StageBuild.BuildCell): in the export of each
+/// actor's root component (BodySkeletalMesh, a CrowdSkeletalMeshComponent), the three RelativeLocation doubles and the Yaw
+/// double of RelativeRotation are rewritten in place. Export sizes, header, names and imports are unchanged; the respawn
+/// box and the ground decal are attached to the root and follow it; body, clothes and props are attached to the skeleton at
+/// BeginPlay. The host values to look for come from CUE4Parse (the game's own package), as in BuildCell.
+///
+/// Yaw: these skeletal meshes face their component's +Y. Measured on Hafren South's own BC_Marshal_C placed by the studio
+/// within 25 m of the road: (direction to the nearest centreline point) - yaw = +90 deg for 80 of 96 (all within +-45 deg).
+internal static class Characters
+{
+    const string RootName = "BodySkeletalMesh";
+    const double MeshFacingDeg = 90;
+
+    /// Actor label (editor name, as in stage.json) -> export name and class in WalesS4HafrenSouth.umap (build of 14/11/2026).
+    /// A game update that renames them makes the build stop here with a clear message.
+    static readonly Dictionary<string, (string Export, string Class)> Known = new()
+    {
+        ["BC_HighResCrowd"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1644464790", "BC_HighResCrowd_C"),
+        ["BC_HighResCrowd2"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1647577791", "BC_HighResCrowd_C"),
+        ["BC_HighResCrowd3"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1651290792", "BC_HighResCrowd_C"),
+        ["BC_HighResCrowd4"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1756948793", "BC_HighResCrowd_C"),
+        ["BC_HighResCrowd5"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1791494794", "BC_HighResCrowd_C"),
+        ["BC_HighResCrowd6"] = ("BC_HighResCrowd_C_UAID_04421A0DCF0D139D02_3d3e525db80efa5b_1794817795", "BC_HighResCrowd_C"),
+        ["BC_Marshal110"] = ("BC_Marshal_C_UAID_04421A0DCF0D129D02_3d3e525db80efa5b_1603956609", "BC_Marshal_C"),
+        ["BC_Marshal111"] = ("BC_Marshal_C_UAID_04421A0DCF0D129D02_3d3e525db80efa5b_1655590610", "BC_Marshal_C"),
+        ["BC_Marshal112"] = ("BC_Marshal_C_UAID_04421A0DCF0D129D02_3d3e525db80efa5b_1659462611", "BC_Marshal_C"),
+        ["BC_Marshal113"] = ("BC_Marshal_C_UAID_04421A0DCF0D129D02_3d3e525db80efa5b_1794298613", "BC_Marshal_C"),
+    };
+
+    static string F(double v, string fmt = "0.##") => v.ToString(fmt, CultureInfo.InvariantCulture);
+
+    static int Root(LegacyPackage pkg, string export, string? cls)
+    {
+        int a = pkg.FindExport(export, cls);
+        return pkg.FindExport(RootName, null, e => pkg.ExportOuter(e) == a + 1);
+    }
+
+    public static JsonObject Build(string legacy, string outRoot, string irDir, StageBuild.Placement pl, Options o)
+    {
+        var stage = JsonNode.Parse(File.ReadAllText(Path.Combine(irDir, "stage.json")))!;
+        var items = stage["characters"]?["items"] as JsonArray
+            ?? throw new InvalidDataException("--characters 1: stage.json has no characters.items");
+        var dest = Path.Combine(outRoot, Scenery.Persistent + ".umap");
+        var src = File.Exists(dest) ? dest : HostPaths.Resolve(legacy, Scenery.Persistent);
+        var pkg = new LegacyPackage(src);
+        var (h0, u0) = pkg.Save();
+        var before = Enumerable.Range(0, pkg.ExportCount).Select(e => (byte[])pkg.GetExportData(e).Clone()).ToArray();
+
+        using var provider = Program.Open(o);
+        var exports = provider.LoadPackage(Scenery.PersistentLevel).GetExports().ToList();
+
+        var moved = new JsonArray();
+        var comps = new HashSet<int>();
+        foreach (var it in items)
+        {
+            string label = it!["actor"]!.GetValue<string>();
+            if (!Known.TryGetValue(label, out var k))
+                throw new InvalidDataException($"characters: unknown actor {label} (known: {string.Join(", ", Known.Keys)})");
+            int c = Root(pkg, k.Export, k.Class);
+            if (!comps.Add(c)) throw new InvalidDataException($"characters: {label} listed twice");
+            var host = exports.Single(x => x.Name == RootName && x.Outer?.Name.ToString() == k.Export);
+            if (!host.TryGetValue(out FVector hl, "RelativeLocation") || !host.TryGetValue(out FRotator hr, "RelativeRotation"))
+                throw new InvalidDataException($"characters: {label} root has no stored RelativeLocation / RelativeRotation");
+            double[] pos = it["position"]!.AsArray().Select(v => v!.GetValue<double>()).ToArray();
+            double[] fwd = it["forward"]!.AsArray().Select(v => v!.GetValue<double>()).ToArray();
+            var ue = pl.ToUe(pos);
+            // gaze direction through the same placement (rotation about Y), then UE heading = atan2(UE Y, UE X) = atan2(phys z, phys x)
+            var p0 = pl.ToPhysics(0, 0, 0);
+            var p1 = pl.ToPhysics(fwd[0], 0, fwd[2]);
+            double heading = Math.Atan2(p1.Z - p0.Z, p1.X - p0.X) * 180 / Math.PI;
+            double yaw = StageBuild.NormDeg(heading - MeshFacingDeg);
+
+            var data = (byte[])pkg.GetExportData(c).Clone();
+            int locAt = StageBuild.FindDoubles(data, [hl.X, hl.Y, hl.Z]);
+            int rotAt = StageBuild.FindDoubles(data, [hr.Pitch, hr.Yaw, hr.Roll]);
+            StageBuild.WriteDoubles(data, locAt, ue.X, ue.Y, ue.Z);
+            StageBuild.WriteDoubles(data, rotAt + 8, yaw);
+            pkg.SetExportData(c, data);
+            moved.Add(new JsonObject
+            {
+                ["actor"] = label, ["export"] = k.Export, ["class"] = k.Class, ["root_export"] = c,
+                ["role"] = it["role"]?.GetValue<string>(), ["pk_m"] = it["pk_m"]?.GetValue<double>(),
+                ["from_ue"] = new JsonArray((double)hl.X, (double)hl.Y, (double)hl.Z), ["from_yaw"] = (double)hr.Yaw,
+                ["to_ue"] = new JsonArray(ue.X, ue.Y, ue.Z), ["pitch"] = (double)hr.Pitch, ["yaw"] = yaw, ["roll"] = (double)hr.Roll,
+            });
+            Console.WriteLine($"  character {label}: UE ({F(hl.X, "0")}, {F(hl.Y, "0")}, {F(hl.Z, "0")}) yaw {F(hr.Yaw, "0.#")} -> " +
+                              $"({F(ue.X, "0")}, {F(ue.Y, "0")}, {F(ue.Z, "0")}) yaw {F(yaw, "0.#")}  [{it["role"]?.GetValue<string>()}]");
+        }
+
+        // self-check: same header and package size; the only bytes changed are 32 per moved root (3 location doubles + yaw)
+        var (h1, u1) = pkg.Save();
+        int changed = 0, otherExports = 0;
+        for (int e = 0; e < pkg.ExportCount; e++)
+        {
+            var a = before[e]; var b = pkg.GetExportData(e);
+            if (a.Length != b.Length) throw new InvalidDataException($"characters: export {e} changed size");
+            int n = 0;
+            for (int i = 0; i < a.Length; i++) if (a[i] != b[i]) n++;
+            if (n > 0 && !comps.Contains(e)) otherExports++;
+            changed += n;
+        }
+        if (!h0.AsSpan().SequenceEqual(h1) || u0.Length != u1.Length || otherExports > 0 || changed > 32 * comps.Count)
+            throw new InvalidDataException($"characters: unexpected change (header same {h0.AsSpan().SequenceEqual(h1)}, uexp {u0.Length} -> {u1.Length} bytes, " +
+                                           $"{otherExports} other exports changed, {changed} bytes changed)");
+        if (src != dest)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+            foreach (var ext in new[] { ".ubulk", ".uptnl" })
+                if (File.Exists(Path.ChangeExtension(src, ext))) File.Copy(Path.ChangeExtension(src, ext), Path.ChangeExtension(dest, ext), true);
+        }
+        pkg.SaveTo(dest);
+        Console.WriteLine($"characters: {comps.Count} service-park actors of the persistent level moved; header and size unchanged, {changed} bytes rewritten");
+        return new JsonObject { ["moved"] = moved, ["bytes_changed"] = changed, ["header_unchanged"] = true, ["source"] = Path.GetFileName(src) };
+    }
+
+    /// stage-check: every moved root holds its new location and rotation once, and its host location no more.
+    public static int Check(string root, JsonNode report, TextWriter w)
+    {
+        int failures = 0;
+        void C(bool ok, string what) { w.WriteLine($"{(ok ? "PASS" : "FAIL")} {what}"); if (!ok) failures++; }
+        var pkg = new LegacyPackage(HostPaths.Resolve(root, Scenery.Persistent));
+        var moved = report["moved"]!.AsArray();
+        var bad = new List<string>();
+        foreach (var m in moved)
+        {
+            string label = m!["actor"]!.GetValue<string>();
+            static double N(JsonNode? n) => double.Parse(n!.ToJsonString(), CultureInfo.InvariantCulture);
+            double[] V(string key) => m[key]!.AsArray().Select(N).ToArray();
+            try
+            {
+                // by name only: after a retoc round trip the class of these exports reads as UnknownExport
+                var d = pkg.GetExportData(Root(pkg, m["export"]!.GetValue<string>(), null));
+                StageBuild.FindDoubles(d, V("to_ue"));
+                StageBuild.FindDoubles(d, [N(m["pitch"]), N(m["yaw"]), N(m["roll"])]);
+                try { StageBuild.FindDoubles(d, V("from_ue")); bad.Add($"{label}: host location still present"); }
+                catch (InvalidDataException) { }
+            }
+            catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException) { bad.Add($"{label}: {ex.Message}"); }
+        }
+        C(bad.Count == 0 && moved.Count > 0,
+          $"characters: {moved.Count - bad.Count} of {moved.Count} persistent-level marshals / spectators at their stage place and heading" +
+          (bad.Count > 0 ? $" ({string.Join("; ", bad)})" : ""));
+        return failures;
+    }
+}
